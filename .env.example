# DAREG API environment template
# Copy this file to .env and replace every placeholder with an appropriate value.
# Values in this file are examples only. Never commit real credentials.

# Django
# Generate a long random value for production, for example:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true

# Space-separated hostnames/IP addresses accepted by Django.
# Use the public API hostname(s) in production; avoid '*' outside local development.
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Space-separated origins. These values are used for both CORS and CSRF trust.
DJANGO_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:5000 http://localhost:8083

# Set to true to run Gunicorn through init.sh; false runs Django's development server.
PRODUCTION=false

# PostgreSQL
DB_NAME=dareg
DB_USER=postgres
DB_PASSWORD=replace-with-postgres-password
DB_HOST=localhost
DB_PORT=5432

# OIDC provider
OIDC_AUTHORIZATION_ENDPOINT=https://id.example.org/oidc/auth/authorize
OIDC_TOKEN_ENDPOINT=https://id.example.org/oidc/token
OIDC_USER_ENDPOINT=https://id.example.org/oidc/userinfo
OIDC_JWKS_ENDPOINT=https://id.example.org/oidc/jwk
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret

# Set to "None" to allow any eduperson entitlement, or provide the required entitlement.
OIDC_ALLOWED_EDUPERSON_ENTITLEMENT=None
OIDC_LOGOUT_REDIRECT_URL=https://id.example.org/oidc/endsession

# Job engine tuning (all values are integers).
JOB_ENGINE_SUBMIT_LIMIT=20
JOB_ENGINE_POLL_LIMIT=20
JOB_LOOP_INTERVAL=60

# DataCite DOI integration. Credentials can be empty when DOI functionality is unused.
# The API code defaults to the test endpoint shown here.
DATACITE_API_URL=https://api.test.datacite.org/dois
DATACITE_API_USERNAME=
DATACITE_API_PASSWORD=

# Public frontend URL used when constructing dataset links in DataCite metadata.
FRONTEND_URL=http://localhost:3000

# Application metadata returned by the API. APP_VERSION and APP_VERSION_DATE are optional.
APP_VERSION=0.0.0
APP_VERSION_DATE=1970-01-01
APP_ENV=local

# Used by workflow-demo-hashes-of-the-files/code/handler.py when running that worker.
# The handler verifies TLS certificates unless this is explicitly set to false.
VERIFY_SSL_CERTIFICATES=true

# Onedata access control (groups + ACLs)
# ONEDATA_SERVICE_TOKEN is a secret (k8s: put it into the ${APP}-secrets secret).
ONEDATA_SYNC_ENABLED=false
ONEDATA_ONEZONE_URL=https://onedata.e-infra.cz/api/v3/onezone
ONEDATA_ONEZONE_GUI_URL=https://onedata.e-infra.cz/ozw/onezone/i
ONEDATA_SERVICE_TOKEN=
ONEDATA_SERVICE_USER_ID=
ONEDATA_ROOT_GROUP_ID=
ONEDATA_ADMINS_GROUP_ID=
ONEDATA_SYNC_EVERY_N_CYCLES=1
ONEDATA_FULL_PASS_EVERY_N=10
# invite (users join via "Activate Onedata access") | direct (needs oz_* admin privileges)
ONEDATA_MEMBERSHIP_MODE=invite
# off | report (only log unused DAREG groups) | delete (remove them from Onedata)
ONEDATA_ORPHAN_CLEANUP=report
